APP_NAME=ai-development-team-orchestrator
APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_NAME=orchestrator.log
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3

DATA_DIR=data
PROJECTS_ROOT=projects
SQLITE_DB_PATH=data/orchestrator.db
GRAPH_CHECKPOINT_PATH=data/langgraph_checkpoints.sqlite
GRAPH_THREAD_PREFIX=phase1
HTTP_TIMEOUT_SECONDS=20.0
CONTEXT_MAX_DECISIONS=5
CONTEXT_OUTPUT_FILE=context.md

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash
MANAGER_USE_GEMINI=1
MANAGER_MODEL=gemini-2.0-flash
MANAGER_MAX_HISTORY_TURNS=12
USE_LEGACY_PLANNER=0

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_MODEL_SECONDARY=openai/gpt-4.1-mini
OPENROUTER_API_KEY_PRIMARY=
OPENROUTER_API_KEY_SECONDARY=
WORKER_USE_STUB=0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
