APP_NAME=ai-development-team-orchestrator
APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE_NAME=orchestrator.log
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3

DATA_DIR=data
PROJECTS_ROOT=projects
SQLITE_DB_PATH=data/orchestrator.db
GRAPH_CHECKPOINT_PATH=data/langgraph_checkpoints.sqlite
GRAPH_THREAD_PREFIX=phase1
HTTP_TIMEOUT_SECONDS=20.0
CONTEXT_MAX_DECISIONS=5
CONTEXT_OUTPUT_FILE=context.md

GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-flash-lite-latest
MANAGER_USE_GEMINI=1
MANAGER_MODEL=gemini-flash-lite-latest
MANAGER_MAX_HISTORY_TURNS=12
USE_LEGACY_PLANNER=0

OLLAMA_BASE_URL=
OLLAMA_MODEL=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-m2.5:free
OPENROUTER_MODEL_SECONDARY=tencent/hy3-preview:free
OPENROUTER_API_KEY_PRIMARY=your_openrouter_primary_key
OPENROUTER_API_KEY_SECONDARY=your_openrouter_secondary_key
WORKER_USE_STUB=0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
