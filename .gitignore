# Local secrets; only sanitized example files belong in Git.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json

# Python environments, caches, and packaging output.
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/

# Runtime state, backups, logs, and generated projects.
/data/*
!/data/.gitkeep
/logs/*
!/logs/.gitkeep
/projects/*
!/projects/.gitkeep
*.log
*.log.*
*.pid
*.sqlite
*.sqlite-*
*.sqlite.bak
*.db
*.db-*
*.db.bak

# Dependencies and locally downloaded reference repositories.
node_modules/
/crewAI-main/

# Editor and operating-system files.
.DS_Store
._*
Thumbs.db
.idea/
*.swp
*.swo
*~
