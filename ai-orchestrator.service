[Unit]
Description=AI Development Team Orchestrator Daemon
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=caglarkc
WorkingDirectory=/home/caglarkc/Desktop/Github/caglarkc-agent
EnvironmentFile=/home/caglarkc/Desktop/Github/caglarkc-agent/.env
ExecStart=/home/caglarkc/Desktop/Github/caglarkc-agent/.venv/bin/python /home/caglarkc/Desktop/Github/caglarkc-agent/main.py
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStartSec=45
TimeoutStopSec=30
NoNewPrivileges=true
StandardOutput=append:/home/caglarkc/Desktop/Github/caglarkc-agent/logs/systemd.log
StandardError=append:/home/caglarkc/Desktop/Github/caglarkc-agent/logs/systemd.log

[Install]
WantedBy=multi-user.target
